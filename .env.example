# ─────────────────────────────────────────────────────────────────────────────
# Probex — environment configuration
#
# Copy to `.env.local` and fill in values. Every variable below is read through
# src/config/env.ts (client-safe) or getServerEnv() (server-only). Leave values
# blank to keep running on mock data — the UI stays fully functional.
#
# NEXT_PUBLIC_* values are inlined into the client bundle. Never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend / API integration (RUNTIME — read per request) ──────────────────
# These are NOT prefixed with NEXT_PUBLIC_ on purpose. They are read on the
# server at REQUEST time and handed to the browser via window.__PROBEX_RUNTIME__
# (see src/config/runtime.ts), so ONE build can be promoted dev → staging →
# production with no rebuild. NEXT_PUBLIC_* would be inlined at build time and
# weld the artifact to a single environment.
#
# ── Deployment policy (WHERE this is running) ───────────────────────────────
# development | test | staging | production      (default when unset: production)
#
# This is a statement of INTENT and the ONLY authority on whether synthetic data
# may be served. It is deliberately independent of NODE_ENV, which merely
# describes how the JS was compiled and gets set incidentally by Docker images,
# CI runners and start scripts — far too weak a signal to authorise fake trades.
#
#   mock permitted : development, test
#   mock FORBIDDEN : staging, production
#
# Staging is as strict as production on purpose: a staging sign-off obtained
# against fabricated balances validates nothing.
#
# Unset defaults to "production" (fail-safe). Local development opts IN.
# Starting with PROBEX_API_MODE=mock under a policy that forbids it is a FATAL
# error — the process refuses to boot (see src/instrumentation.ts).
PROBEX_DEPLOYMENT=development

# ── Runtime mode (WHAT the app attempts) ────────────────────────────────────
# Service mode: 'auto' (default) | 'live' | 'mock'
#   auto → probe the backend:
#            reachable                  → live
#            unreachable + development  → mock
#            unreachable + production   → Engine Offline (NEVER mock)
#   live → always the real engine, no probe.
#   mock → always synthetic data. Explicit only; banner-flagged in the UI.
PROBEX_API_MODE=auto

# Backend base URL, including the /api prefix. Trailing slashes are tolerated.
# Default is the RELATIVE "/api", which is correct for any reverse proxy that
# serves the API alongside the app (the production nginx bridge does) and needs
# no environment knowledge at all — leave it blank there.
#   • Production / staging behind nginx: (leave blank → /api)
#   • Local dev against the raw engine:  http://136.119.171.6:8000/api
PROBEX_API_BASE_URL=

# Optional. Absolute URL for the SERVER-SIDE health probe used by 'auto'. Lets
# the server check the engine directly instead of looping back through the
# public proxy. e.g. http://127.0.0.1:8000/health
PROBEX_API_PROBE_URL=

# ── Legacy build-time equivalents (DEPRECATED) ──────────────────────────────
# Still honoured as a fallback so existing deployments keep working, but they
# are inlined at build time and are not portable. Prefer the PROBEX_* names.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MODE=

# Reserved: separate consensus API base URL (no consumer in the codebase yet).
NEXT_PUBLIC_CONSENSUS_API_URL=

# Reserved: WebSocket endpoint for live streaming (no consumer in the codebase yet).
NEXT_PUBLIC_WS_URL=

# Reserved: enables the future real-time stream layer (not implemented yet).
NEXT_PUBLIC_ENABLE_REALTIME=

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical app URL (Open Graph / metadata). e.g. https://qubo-probex.duckdns.org/dashboard
# Its ORIGIN is used as metadataBase to resolve absolute OG/Twitter/canonical
# URLs. Leave unset in local dev to fall back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Optional social handle for Twitter/X card `creator` + `site` (e.g. @probex).
# Only emitted when set — leave blank to omit rather than ship a wrong handle.
NEXT_PUBLIC_TWITTER_HANDLE=

# Verbose client debug logging (true/false). Drives the API client request log.
NEXT_PUBLIC_DEBUG=false

# ── Web3 / Polygon (wallet layer) ────────────────────────────────────────────
# Target chain: 137 = Polygon Mainnet, 80002 = Polygon Amoy testnet.
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses (populated at deployment). 0x-prefixed.
NEXT_PUBLIC_CONTRACT_MARKET_137=
NEXT_PUBLIC_CONTRACT_VAULT_137=
NEXT_PUBLIC_CONTRACT_TOKEN_137=
NEXT_PUBLIC_CONTRACT_MARKET_80002=
NEXT_PUBLIC_CONTRACT_VAULT_80002=
NEXT_PUBLIC_CONTRACT_TOKEN_80002=
NEXT_PUBLIC_CONTRACT_USDC_80002=

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ──────────────────────
# Read only via getServerEnv() in server components / API routes / middleware.
JWT_SECRET=
SESSION_SECRET=
DATABASE_URL=
INTERNAL_API_SECRET=
KYC_API_KEY=
